<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>OidcForge.EntityFramework.Storage</PackageId>
    <TargetFramework>net10.0</TargetFramework>
    
    <Description>EntityFramework persistence layer (maintained fork of IdentityServer4)</Description>
    <Authors>Brock Allen;Dominick Baier;Scott Brady;Yaroslav Tatarenko</Authors>
    <PackageTags>OAuth2;OAuth 2.0;OpenID Connect;Security;Identity;IdentityServer;EntityFramework</PackageTags>
    <PackageIcon>icon.jpg</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/yartat/IdentityServer4</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReleaseNotes>https://github.com/yartat/IdentityServer4/blob/master/RELEASE_NOTES.md</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>

    <AssemblyOriginatorKeyFile>../../../key.snk</AssemblyOriginatorKeyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign Condition="'$(OS)' != 'Windows_NT'">true</PublicSign>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../icon.jpg" Pack="true" Visible="false" PackagePath="" />
    <None Include="../README.md" Pack="true" Visible="false" PackagePath="" />
    <None Include="../../.editorconfig" Link=".editorconfig" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Mapster" Version="$(Mapster)" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(DotNetLibrary10xx)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(DotNetLibrary10xx)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Storage\src\IdentityServer4.Storage.csproj" />
  </ItemGroup>

  <!--
    Mapster code generation. Run after changing Mappers\I*Mapper.cs or Mappers\*MapperRegister.cs:
      dotnet build -t:GenerateMappers
    The assembly is first built with MAPSTER_CODEGEN defined and without Mappers\Generated\*.g.cs,
    so generation works even when the generated code is missing or stale. Commit the regenerated files.
  -->
  <PropertyGroup Condition="'$(MapsterCodeGen)' == 'true'">
    <DefineConstants>$(DefineConstants);MAPSTER_CODEGEN</DefineConstants>
    <OutputPath>bin\mapster-codegen\</OutputPath>
    <IntermediateOutputPath>obj\mapster-codegen\</IntermediateOutputPath>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(MapsterCodeGen)' == 'true'">
    <Compile Remove="Mappers\Generated\**" />
  </ItemGroup>

  <Target Name="GenerateMappers">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="MapsterCodeGen=true" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="dotnet tool restore" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="dotnet mapster mapper -a &quot;$(MSBuildProjectDirectory)\bin\mapster-codegen\$(TargetFramework)\$(AssemblyName).dll&quot; -o Mappers\Generated -n IdentityServer4.EntityFramework.Mappers -p" />
  </Target>

</Project>
